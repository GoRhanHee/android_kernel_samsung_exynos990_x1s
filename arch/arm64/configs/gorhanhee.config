# Disable Scamsung anti-root protection
CONFIG_UH=n
CONFIG_FASTUH_RKP=n
CONFIG_UH_RKP_FIMC_CHECK=n
CONFIG_KDP_CRED=n
CONFIG_KDP_NS=n
CONFIG_KDP_DMAP=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_UH_PDBT=n
CONFIG_RKP_CFP=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_JOPP_MAGIC=n

CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_FIVE=n

# Kernel LocalVersion
CONFIG_LOCALVERSION="-GoRhanHee_Kernel_S20"
CONFIG_LOCALVERSION_AUTO=n

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_KPROBES_KSUD=n
CONFIG_KSU_LSM_SECURITY_HOOKS=y